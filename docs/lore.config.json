{
  "version": 1,
  "theme": {
    "tokens": {
      "color-primary": "#2fca94",
      "color-secondary": "#b8a8dc",
      "color-accent": "#2fca94",
      "color-background": "#0e1018",
      "color-foreground": "#f0f0f4",
      "color-muted": "#8890b0",
      "color-border": "#2a2e40",
      "font-sans": "DM Sans, system-ui, sans-serif",
      "font-mono": "DM Mono, ui-monospace, monospace",
      "radius": "6px"
    },
    "spacing": {
      "page-max-width": "1180px",
      "content-padding": "clamp(20px, 4vw, 56px)",
      "nav-height": "64px",
      "section-gap": "44px",
      "element-gap": "14px"
    },
    "effects": {
      "shadow-sm": "0 1px 2px rgba(0,0,0,0.2)",
      "shadow-md": "0 18px 50px rgba(0,0,0,0.24)",
      "transition-fast": "150ms cubic-bezier(0.23, 1, 0.32, 1)",
      "transition-normal": "300ms cubic-bezier(0.23, 1, 0.32, 1)"
    }
  },
  "templates": {
    "hero": "# {{title}}\n\n{{description}}",
    "api_reference": "# {{title}} API\n\n## Endpoint\n\n`{{method}} {{path}}`",
    "changelog": "# Changelog\n\n## {{version}} - {{date}}\n\n{{changes}}",
    "runbook": "# Runbook: {{title}}\n\n## Steps\n\n{{steps}}"
  },
  "navigation": {
    "primary": [
      { "label": "Overview", "href": "/docs" },
      { "label": "Install Safety", "href": "/docs/install-safety.md" },
      { "label": "Lifecycle", "href": "/docs/lifecycle.md" }
    ],
    "footer": [
      { "label": "Install", "href": "/install" },
      { "label": "Checksums", "href": "/install/checksums.txt" },
      { "label": "Manifest", "href": "/install/release-manifest.json" }
    ]
  },
  "agent_rendering": {
    "default": {
      "mode": "polished_dark",
      "include_provenance": true,
      "strip_chrome": false
    },
    "claude": {
      "mode": "compact_dark",
      "include_provenance": true,
      "strip_chrome": true
    },
    "cursor": {
      "mode": "compact_dark",
      "include_provenance": true,
      "strip_chrome": true
    }
  },
  "embed": {
    "mounted_at": "/docs",
    "theme_inherit": "host"
  }
}
